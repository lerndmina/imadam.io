---
import Link from "./Link.astro";
import type { Monitor } from "../utils/types";

interface Props {
  verbosity?: "full" | "short" | "icon";
  withLink?: boolean;
  customText?: string;
}

let { verbosity = "full", withLink = true, customText } = Astro.props as Props;

let linkText = "⏳ Loading";
let tooltipText = "Loading status...";
let linkUrl = "https://status.imadam.io";

if (customText) {
  linkText = customText;
}

export const statusUrl = "https://raw.githubusercontent.com/lerndmina/uptime/master/history/summary.json";

export enum ServiceStatus {
  UP = "up",
  DOWN = "down",
  DEGRADED = "degraded",
  UNAVAILABLE = "unavailable",
}

export enum ServiceStatusTooltips {
  UP = "Service is up and running",
  DOWN = "Service is down",
  DEGRADED = "Some services are degraded",
  UNAVAILABLE = "Unable to fetch service status, try clicking the link",
}

export function translateStatusToEmoji(status: ServiceStatus): string {
  switch (status) {
    case ServiceStatus.UP:
      return "🟢";
    case ServiceStatus.DOWN:
      return "🔴";
    case ServiceStatus.DEGRADED:
      return "🟡";
    case ServiceStatus.UNAVAILABLE:
      return "❓";
  }
}

export function translateStatusTooltips(status: ServiceStatus): string {
  switch (status) {
    case ServiceStatus.UP:
      return ServiceStatusTooltips.UP;
    case ServiceStatus.DOWN:
      return ServiceStatusTooltips.DOWN;
    case ServiceStatus.DEGRADED:
      return ServiceStatusTooltips.DEGRADED;
    case ServiceStatus.UNAVAILABLE:
      return ServiceStatusTooltips.UNAVAILABLE;
  }
}

export async function fetchServiceStatus(): Promise<Monitor[] | ServiceStatus.UNAVAILABLE> {
  let response: Response;
  let data: Monitor[] | string;
  try {
    response = await fetch(statusUrl, {});
    data = (await response.json()) as Monitor[];
    return data;
  } catch (error) {
    return ServiceStatus.UNAVAILABLE;
  }
}

let monitors = await fetchServiceStatus();
let emoji: string = "";
export function getStatusEmojiAndTooltip(status) {
  return {
    emoji: translateStatusToEmoji(status),
    tooltipText: translateStatusTooltips(status),
  };
}
export async function getServiceStatus(monitors: Monitor[]){
  let emoji: string = "";
  let tooltipText: string = "";
  let serviceStauts: ServiceStatus;
  const upMonitors = monitors.filter((monitor) => monitor.status === ServiceStatus.UP);
  const downMonitors = monitors.filter((monitor) => monitor.status === ServiceStatus.DOWN);

  if (upMonitors.length === monitors.length) {
    serviceStauts = ServiceStatus.UP;
  } else if (downMonitors.length === monitors.length) {
    serviceStauts = ServiceStatus.DOWN;
  } else {
    serviceStauts = ServiceStatus.DEGRADED;
  }

  ({ emoji, tooltipText } = getStatusEmojiAndTooltip(serviceStauts));

  return { emoji, tooltipText, serviceStauts };
}


// Last thing to do is set linktext
linkText = "Service Status";
---

<span title={tooltipText}><Link href={linkUrl}>{withLink ? linkText : ""}</Link>{withLink ? " " : linkText + " "}{emoji}</span>
